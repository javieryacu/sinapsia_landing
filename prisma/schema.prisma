generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CONSULTANT
  SALES
  DEVELOPER
}

enum Stage {
  PROSPECTO
  CONTACTO
  CONVERSACION
  DIAGNOSTICO
  PROPUESTA
  GANADO
  PERDIDO
}

enum Priority {
  BAJA
  MEDIA
  ALTA
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  TASK
}

enum SolutionType {
  OPTIMIZAR
  AUTOMATIZAR
  INTEGRAR
  INTELIGENCIA_ARTIFICIAL
  DESARROLLAR
  COMBINADO
}

enum ProjectStatus {
  PENDIENTE_INICIO
  EN_DESARROLLO
  PRE_PRODUCCION
  COMPLETADO
  PAUSADO
  CANCELADO
}

enum PhaseStatus {
  ANALISIS_PROFUNDO
  DESARROLLO
  QA_INTERNO
  QA_CLIENTE
  LISTO
}

enum PaymentStatus {
  PENDIENTE
  FACTURADO
  COBRADO
}

enum PaymentMilestone {
  ADELANTO_30
  PRE_PRODUCCION_40
  CIERRE_30
  FEATURE_EXTRA
  PERSONALIZADO
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  password      String
  role          Role           @default(CONSULTANT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  opportunities Opportunity[]
  activities    Activity[]
  leadProjects  Project[]      @relation("ProjectLead")
  soldProjects  Project[]      @relation("ProjectSeller")

  @@map("users")
}

model Company {
  id            String         @id @default(cuid())
  name          String
  industry      String?
  size          String?
  location      String?
  website       String?
  phone         String?
  notes         String?        @db.Text
  isClient      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contacts      Contact[]
  opportunities Opportunity[]
  projects      Project[]

  @@map("companies")
}

model Contact {
  id              String         @id @default(cuid())
  companyId       String
  name            String
  email           String?
  phone           String?
  role            String?
  isDecisionMaker Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunities   Opportunity[]

  @@map("contacts")
}

model Opportunity {
  id                  String        @id @default(cuid())
  title               String
  companyId           String
  contactId           String?
  assignedUserId      String?
  stage               Stage         @default(PROSPECTO)
  priority            Priority      @default(MEDIA)
  estimatedValue      Float?
  expectedCloseDate   DateTime?
  lostReason          String?
  summary             String?       @db.Text
  problemDescription  String?       @db.Text
  solutionType        SolutionType?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact             Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedUser        User?         @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  activities          Activity[]
  project             Project?

  @@map("opportunities")
}

model Activity {
  id             String       @id @default(cuid())
  opportunityId  String
  userId         String
  type           ActivityType @default(NOTE)
  content        String       @db.Text
  scheduledFor   DateTime?
  isCompleted    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activities")
}

model Project {
  id              String         @id @default(cuid())
  opportunityId   String?        @unique
  companyId       String
  leadDeveloperId String?
  sellerId        String?
  title           String
  description     String?        @db.Text
  totalValue      Float          @default(0)
  status          ProjectStatus  @default(PENDIENTE_INICIO)
  startDate       DateTime?
  estimatedEndDate DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity     Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  leadDeveloper   User?          @relation("ProjectLead", fields: [leadDeveloperId], references: [id], onDelete: SetNull)
  seller          User?          @relation("ProjectSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  phases          ProjectPhase[]
  payments        Payment[]

  @@map("projects")
}

model ProjectPhase {
  id          String      @id @default(cuid())
  projectId   String
  title       String
  description String?     @db.Text
  order       Int         @default(1)
  status      PhaseStatus @default(ANALISIS_PROFUNDO)
  isPostSale  Boolean     @default(false)
  cost        Float?
  startDate   DateTime?
  deliveryDate DateTime?
  closedDate  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@map("project_phases")
}

model Payment {
  id          String           @id @default(cuid())
  projectId   String
  phaseId     String?
  concept     String
  milestone   PaymentMilestone @default(PERSONALIZADO)
  percentage  Int?
  amount      Float
  status      PaymentStatus    @default(PENDIENTE)
  dueDate     DateTime?
  paidDate    DateTime?
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase       ProjectPhase?    @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@map("payments")
}
